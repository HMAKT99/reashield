{
  "name": "reashield",
  "version": "0.7.2",
  "description": "Drop-in defensive hardening that starves automated, agent-driven reverse engineering (e.g. REA) of your own shipped JavaScript/npm artifact. Raises cost; never claims impossibility.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reashield": "dist/cli.js",
    "reashield-mcp": "dist/mcp.js"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.cjs"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "require": "./dist/electron.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "cd examples/sample-package && node ../../dist/cli.js test",
    "example:test": "node --test examples/sample-package/test/sample.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/unit.test.mjs && node --test examples/sample-package/test/sample.test.mjs && node --test examples/sample-package/test/rollup-plugin.test.mjs && node --test test/electron.test.mjs && node --test test/wasm.test.mjs && node --test examples/sample-package/test/auth-web.test.mjs",
    "e2e:http": "npm run build && node examples/sample-package/e2e-http.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reverse-engineering",
    "hardening",
    "obfuscation",
    "defensive",
    "rea",
    "shield",
    "anti-tamper"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "esbuild": "^0.23.0",
    "javascript-obfuscator": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.5.0",
    "bytenode": "^1.7.0",
    "rollup": "^4.67.2",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@electron/fuses": "^1.8.0",
    "bytenode": "^1.5.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMAKT99/reashield.git"
  },
  "bugs": {
    "url": "https://github.com/HMAKT99/reashield/issues"
  },
  "homepage": "https://github.com/HMAKT99/reashield#readme",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.HMAKT99/reashield"
}
